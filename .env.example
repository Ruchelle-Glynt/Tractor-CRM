# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string from Neon or Supabase (create a project, copy the
# "connection string" they give you - it looks like postgres://user:pass@host/db)
DATABASE_URL="postgresql://user:password@host:5432/tractor_crm"

# NextAuth needs a random secret to sign session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-generated-value"
NEXTAUTH_URL="http://localhost:3000"

# Resend (for birthday/renewal emails - Section 5 of the spec). Not required
# to run the app locally; only needed once triggers are built.
RESEND_API_KEY=""
EMAIL_SENDER_DEFAULT="info@tractoroutdoor.com"
